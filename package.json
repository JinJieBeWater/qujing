{
  "name": "qujing",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run build:release all",
    "build:release": "bun run scripts/build-release.ts",
    "build:transport": "bun run scripts/build-transport.ts",
    "check": "vp check && bun run check-types",
    "check-types": "tsc --noEmit && bun run --cwd apps/cli check-types",
    "start": "bun run --cwd apps/cli src/cli.ts",
    "test": "bun run --cwd apps/cli test",
    "test:go": "bun run --cwd apps/cli test:go",
    "test:transport:e2e": "bun run build:transport && scripts/test-transport-e2e.sh",
    "verify": "bun run test && bun run check && bun run test:go",
    "lint": "vp lint",
    "format": "vp fmt",
    "staged": "vp staged",
    "hooks:setup": "vp config"
  },
  "devDependencies": {
    "@qujing/config": "workspace:*",
    "@types/bun": "1.3.14",
    "@types/node": "^26.2.0",
    "typescript": "^6.0.3",
    "vite-plus": "0.3.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "packageManager": "bun@1.3.14"
}
