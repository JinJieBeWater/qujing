{
  "name": "@qujing/cli",
  "version": "0.1.2",
  "private": true,
  "bin": {
    "qj": "./src/cli.ts"
  },
  "type": "module",
  "scripts": {
    "check-types": "tsc --noEmit",
    "start": "bun src/cli.ts",
    "test": "bun test --path-ignore-patterns='**/*.effect.test.ts' --path-ignore-patterns='**/peer-runtime.test.ts' && bun test tests/peer-runtime.test.ts && bun --bun vitest run tests/*.effect.test.ts",
    "test:go": "cd native/transport && go test ./..."
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0-rc.112",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@tanstack/ai": "0.53.0",
    "@tanstack/ai-acp": "0.3.9",
    "@tanstack/ai-persistence": "0.5.6",
    "@tanstack/ai-sandbox": "0.5.6",
    "@tanstack/ai-sandbox-local-process": "0.2.5",
    "effect": "4.0.0-rc.112",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.112",
    "@qujing/config": "workspace:*",
    "vitest": "4.1.11"
  }
}
